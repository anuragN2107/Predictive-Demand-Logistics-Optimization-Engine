# ==============================================================================
# METROGRID ENGINE .GITIGNORE CONFIGURATION
# ==============================================================================

# 1. Python Cache & Compiled Files (Clutters code review)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.egs/
*.egg-info/
dist/
build/

# 2. Virtual Environments (Never upload libraries to GitHub; rely on requirements.txt)
venv/
.venv/
env/
ENV/
pyenv/

# 3. Massive Datasets & Parquet Gaps
# (Protects repository size limits by forcing live streaming or keeping local data hidden)
data/
*.parquet
*.csv
*.json
*.xlsx
*.zip
*.gz

# 4. Jupyter Notebook System Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.html

# 5. Local Credentials & Environment Configuration Profiles
.env
.flaskenv
config.local.yaml
secrets.yaml

# 6. Operating System Specific Artifacts
.DS_Store
Thumbs.db
